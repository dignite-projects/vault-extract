<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Dignite.Abp.FlexFields.* packages (org: dignite-projects). abp-modules publishes
         pre-release versions to GitHub Packages first; nuget.org sync lags behind (sometimes by
         days), so pinning a version this repo actually needs right now means resolving it from
         here instead. Reintroduces what #595 removed - see that PR for the contributor-friction
         tradeoff; acceptable while this repo has no external contributors.

         Reading GitHub Packages requires auth even for public packages: set env var
         GITHUB_PACKAGES_TOKEN to a PAT with the read:packages scope. -->
    <add key="github" value="https://nuget.pkg.github.com/dignite-projects/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <github>
      <add key="Username" value="dignite-projects" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_TOKEN%" />
    </github>
  </packageSourceCredentials>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Microsoft.*" />
      <package pattern="Volo.*" />
    </packageSource>
    <packageSource key="github">
      <package pattern="Dignite.Abp.FlexFields.*" />
      <package pattern="Dignite.Abp.AspNetCore.Mcp" />
    </packageSource>
  </packageSourceMapping>
</configuration>
