<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Every dependency, Dignite.Abp.* included, resolves from nuget.org. abp-modules 10.7.0 is
         stable and published there; its GitHub Packages feed carries pre-releases only, so the
         `github` source that pinned Dignite.Abp.FlexFields.* / Dignite.Abp.AspNetCore.Mcp to it
         (needed while this repo tracked abp-modules rc builds) is gone, and with it the need for
         a GITHUB_PACKAGES_TOKEN to restore. Re-add it only if a pin moves back to a pre-release
         that has not reached nuget.org yet. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
