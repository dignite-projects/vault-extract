<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Dignite.Vault.Extract</RootNamespace>
    <Description>Application layer of Dignite Vault Extract — the core of the document channel: document storage, text-extraction pipeline orchestration, LLM-based document classification, type-bound field extraction and outbound integration event publishing.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dignite.Vault.Extract.Application.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="ClosedXML" />
    <!-- #680: the notification framework's contracts (definitions + INotificationPublisher; no ASP.NET, no
         distributor). The channel and the inbox are the host's choice - see
         VaultExtractNotificationConsts.SignalRChannelName. -->
    <PackageReference Include="Dignite.Abp.Notifications.Abstractions" />
    <PackageReference Include="Volo.Abp.BackgroundJobs" />
    <PackageReference Include="Volo.Abp.BlobStoring" />
    <PackageReference Include="Volo.Abp.Auditing" />
    <!-- #698: only the event contract (GdprUserDataDeletionRequestedEto). The GDPR module that publishes it is the
         host's choice and is commercial; this package is LGPL-3.0-only (per its nuspec) and depends only on ABP
         packages (Core, EventBus.Abstractions). -->
    <PackageReference Include="Volo.Abp.Gdpr.Abstractions" />
    <PackageReference Include="Volo.Abp.Ddd.Application" />
    <PackageReference Include="Volo.Abp.Mapperly" />
    <ProjectReference Include="..\Dignite.Vault.Extract.Abstractions\Dignite.Vault.Extract.Abstractions.csproj" />
    <ProjectReference Include="..\Dignite.Vault.Extract.Application.Contracts\Dignite.Vault.Extract.Application.Contracts.csproj" />
    <ProjectReference Include="..\Dignite.Vault.Extract.Domain\Dignite.Vault.Extract.Domain.csproj" />
  </ItemGroup>

</Project>
