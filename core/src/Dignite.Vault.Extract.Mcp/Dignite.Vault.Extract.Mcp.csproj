<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Dignite.Vault.Extract</RootNamespace>
    <Description>MCP server exit of Dignite Vault Extract: exposes documents, document types, and cabinets as resources and provides structured metadata/extracted-field search tools for Claude Desktop, Cursor, and any MCP client. Contributes to the application's shared MCP server (Dignite.Abp.AspNetCore.Mcp) under the vault_extract namespace.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" VersionOverride="10.9.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <!-- The shared MCP server this module contributes to (AddAbpMcpModule) instead of hosting its own. -->
    <PackageReference Include="Dignite.Abp.AspNetCore.Mcp" />
    <!-- Used only to translate EntityNotFoundException from AppService.GetAsync into a clean McpException
         resource not-found protocol error. This is ABP's DDD abstractions package; the REST HttpApi exit
         also receives it transitively through AspNetCore.Mvc. This does not conflict with #222
         "exits do not depend on the Extract.Application implementation project" because it does not
         introduce transitive OCR / LLM / pipeline implementation dependencies. -->
    <PackageReference Include="Volo.Abp.Ddd.Domain" />
    <!--
      The MCP field schema has to tell a client whether a field is multi-valued, which is a fact about
      which field types Vault Extract picked (VaultExtractFieldTypes), not one the kernel exposes.
    -->
    <ProjectReference Include="..\Dignite.Vault.Extract.FlexFields\Dignite.Vault.Extract.FlexFields.csproj" />
    <ProjectReference Include="..\Dignite.Vault.Extract.Application.Contracts\Dignite.Vault.Extract.Application.Contracts.csproj" />
  </ItemGroup>

</Project>
