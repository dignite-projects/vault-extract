# Kept, and NOT removable by upgrading ABP: @abp/ng.theme.shared 10.7 still depends on
# @swimlane/ngx-datatable@~22.0.0 and @ng-bootstrap/ng-bootstrap@~20.0.0, whose peer ranges stop
# at Angular 20 and 21 while this workspace is on Angular 22. Strict resolution refuses to install
# them and the host build fails on an unresolved import. ABP's own 10.7 Angular template installs
# them under Angular 22 with unmet-peer warnings, and so does the sibling abp-modules repo.
# Revisit when ngx-datatable / ng-bootstrap declare Angular 22 support.
legacy-peer-deps=true
