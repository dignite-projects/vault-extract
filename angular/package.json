{
  "name": "vault-extract-workspace",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "projects/*"
  ],
  "scripts": {
    "start": "ng serve host",
    "build": "npm run build:vault-extract && ng build host",
    "build:vault-extract": "ng build vault-extract && npm run check:package-deps",
    "check:package-deps": "node build/check-package-deps.mjs dist/vault-extract",
    "build:host": "ng build host",
    "test": "ng test vault-extract --watch=false",
    "test:watch": "ng test vault-extract",
    "lint": "ng lint vault-extract && ng lint host",
    "generate-proxy": "abp generate-proxy -t ng -m vault-extract --api-name Default --source host --target vault-extract --url https://localhost:44348"
  },
  "dependencies": {
    "@abp/ng.account": "~10.5.0",
    "@abp/ng.components": "~10.5.0",
    "@abp/ng.core": "~10.5.0",
    "@abp/ng.feature-management": "~10.5.0",
    "@abp/ng.identity": "~10.5.0",
    "@abp/ng.oauth": "~10.5.0",
    "@abp/ng.permission-management": "~10.5.0",
    "@abp/ng.setting-management": "~10.5.0",
    "@abp/ng.tenant-management": "~10.5.0",
    "@abp/ng.theme.lepton-x": "~5.5.0",
    "@abp/ng.theme.shared": "~10.5.0",
    "@angular/animations": "~21.2.0",
    "@angular/aria": "~21.2.0",
    "@angular/common": "~21.2.19",
    "@angular/compiler": "~21.2.19",
    "@angular/core": "~21.2.19",
    "@angular/forms": "~21.2.0",
    "@angular/localize": "~21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "@angular/platform-browser-dynamic": "~21.2.0",
    "@angular/router": "~21.2.0",
    "@dignite/ng.flex-fields": "npm:@dignite-projects/ng.flex-fields@10.0.0-rc.16",
    "@dignite/ng.flex-fields-ckeditor": "npm:@dignite-projects/ng.flex-fields-ckeditor@10.0.0-rc.16",
    "marked": "^18.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.1.0",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@abp/ng.schematics": "~10.5.0",
    "@angular-devkit/build-angular": "~21.2.0",
    "@angular/build": "~21.2.0",
    "@angular/cli": "~21.2.21",
    "@angular/compiler-cli": "~21.2.0",
    "@angular/language-service": "~21.2.0",
    "@types/node": "^26.4.0",
    "angular-eslint": "~21.4.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "ng-packagr": "~21.2.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.0.0"
  }
}
